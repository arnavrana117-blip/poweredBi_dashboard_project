def two_sum(arr, target):
    for i in range(len(arr)):
        for j in range(i + 1, len(arr)):
            if arr[i] + arr[j] == target:
                return [arr[i], arr[j]]

    return []


# Input
arr = [2, 7, 11, 15]
target = 9

# Find two numbers
result = two_sum(arr, target)

# Output
print("Two numbers:", result)

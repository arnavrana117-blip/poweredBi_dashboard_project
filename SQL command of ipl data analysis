SELECT COUNT(*) AS Total_Matches
FROM matches;
SELECT 
season,
COUNT(*) AS Matches
FROM matches
GROUP BY season
ORDER BY season;
SELECT 
winner,
COUNT(*) AS Wins
FROM matches
GROUP BY winner
ORDER BY Wins DESC
LIMIT 10;
SELECT 
batsman,
SUM(batsman_runs) AS Total_Runs
FROM deliveries
GROUP BY batsman
ORDER BY Total_Runs DESC
LIMIT 10;
SELECT 
bowler,
COUNT(*) AS Wickets
FROM deliveries
WHERE is_wicket=1
GROUP BY bowler
ORDER BY Wickets DESC
LIMIT 10;
